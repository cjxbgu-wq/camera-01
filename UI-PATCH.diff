+- (void)onColorInject {
+    UIAlertController *a = [UIAlertController alertControllerWithTitle:@"颜色注入"
+        message:@"输入 R G B (0-255) 与透明度 (0-1)" preferredStyle:UIAlertControllerStyleAlert];
+    double r = 0, g = 0, b = 0, al = 1;
+    vcam_bypass_get_color_inject(&r, &g, &b, &al);
+    [a addTextFieldWithConfigurationHandler:^(UITextField *tf) {
+        tf.keyboardType = UIKeyboardTypeDecimalPad;
+        tf.text = [NSString stringWithFormat:@"%.0f", r * 255];
+        tf.placeholder = @"R 0-255";
+    }];
+    [a addTextFieldWithConfigurationHandler:^(UITextField *tf) {
+        tf.keyboardType = UIKeyboardTypeDecimalPad;
+        tf.text = [NSString stringWithFormat:@"%.0f", g * 255];
+        tf.placeholder = @"G 0-255";
+    }];
+    [a addTextFieldWithConfigurationHandler:^(UITextField *tf) {
+        tf.keyboardType = UIKeyboardTypeDecimalPad;
+        tf.text = [NSString stringWithFormat:@"%.0f", b * 255];
+        tf.placeholder = @"B 0-255";
+    }];
+    [a addTextFieldWithConfigurationHandler:^(UITextField *tf) {
+        tf.keyboardType = UIKeyboardTypeDecimalPad;
+        tf.text = [NSString stringWithFormat:@"%.2f", al];
+        tf.placeholder = @"Alpha 0-1";
+    }];
+    [a addAction:[UIAlertAction actionWithTitle:@"应用" style:UIAlertActionStyleDefault handler:^(UIAlertAction *x) {
+        double rr = MIN(255, MAX(0, [a.textFields[0].text doubleValue])) / 255.0;
+        double gg = MIN(255, MAX(0, [a.textFields[1].text doubleValue])) / 255.0;
+        double bb = MIN(255, MAX(0, [a.textFields[2].text doubleValue])) / 255.0;
+        double aa = MIN(1, MAX(0, [a.textFields[3].text doubleValue]));
+        vcam_bypass_set_color_inject(1, rr, gg, bb, aa);
+        [self refreshStatus];
+    }]];
+    [a addAction:[UIAlertAction actionWithTitle:@"关闭注入" style:UIAlertActionStyleDefault handler:^(UIAlertAction *x) {
+        vcam_bypass_set_color_inject(0, 0, 0, 0, 1);
+        [self refreshStatus];
+    }]];
+    [a addAction:[UIAlertAction actionWithTitle:@"取消" style:UIAlertActionStyleCancel handler:nil]];
+    [self presentViewController:a animated:YES completion:nil];
+}
