+// ---- 功能键分发 ----
+- (void)btnTap:(UIButton *)b {
+    NSInteger tag = b.tag;
+    if (tag == 9) { vcHideMenu(); return; }                 // 关闭面板
+    if (tag == 1) { [self onSelectVideo]; return; }         // 选择视频 (相册)
+    if (tag == 2) { [self onColorInject]; return; }         // 颜色注入 (RGB 输入)
+    if (tag == 3) { [self onSelectImage]; return; }         // 选择图片 (相册)
+    if (tag == 4) {                                         // 视频旋转
+        vcam_bypass_toggle_rotation();
+        [self refreshStatus];
+        return;
+    }
+    if (tag == 5) {                                         // 播放 / 暂停
+        vcam_bypass_set_pause(!vcam_bypass_get_pause());
+        [self refreshStatus];
+        return;
+    }
+    if (tag == 6) {                                         // 画面替换开关
+        vcam_bypass_set_replace(!vcam_bypass_get_replace());
+        [self refreshStatus];
+        return;
+    }
+    if (tag == 10) { [self onAddAction]; return; }          // v34 添加动作
+    if (tag == 11) { [self onActionStop]; return; }         // v34 停止动作
+    if (tag == 30) { [self refreshLogs]; return; }          // v37 刷新日志
+    if (tag == 31) {                                         // v37 复制日志
+        NSString *t = _logView.text;
+        if (t.length) {
+            UIPasteboard *pb = [UIPasteboard generalPasteboard];
+            pb.string = t;
+            UIAlertController *ok = [UIAlertController alertControllerWithTitle:@"已复制到剪贴板"
+                message:[NSString stringWithFormat:@"%lu 行日志", (unsigned long)[t componentsSeparatedByString:@"\n"].count]
+                preferredStyle:UIAlertControllerStyleAlert];
+            [ok addAction:[UIAlertAction actionWithTitle:@"好" style:UIAlertActionStyleDefault handler:nil]];
+            [self presentViewController:ok animated:YES completion:nil];
+        }
+        return;
+    }
+    if (tag == 32) { vcam_bypass_clear_log(); [self refreshLogs]; return; }  // v37 清空日志
+    if (tag >= 100 && tag < 106) { [self onColor:(int)(tag - 100)]; }
