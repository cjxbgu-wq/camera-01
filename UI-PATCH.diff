+    if (gReaderA) { [gReaderA cancelReading]; gReaderA = nil; gOutputA = nil; }
+    if (gActionHold) { CVPixelBufferRelease(gActionHold); gActionHold = NULL; }
+    gPausedFrame = nil;
+    gActionActive = 0;
+    gActionNextPos = 0;
+    gRepeatAcc = 0;
