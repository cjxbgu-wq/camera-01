+// [PATCH-v36] Mach-O 段边界校验: vcam125 偏移是静态逆向固定值, 若千面升级导致
+// 偏移错位, 直接写/挂错地址 = EXC_BAD_ACCESS (信号级, @try 拦不住) → mediaserverd
+// 崩溃循环 → 相机黑屏. 所有偏移操作前先校验地址在 image 映射段内.
+static BOOL vcam_addrInImage(const struct mach_header *mh, uintptr_t addr, BOOL needWrite) {
+    if (!mh) return NO;
+    const struct mach_header_64 *mh64 = (const struct mach_header_64 *)mh;
+    if (mh64->magic != MH_MAGIC_64 || mh64->ncmds == 0) return NO;
+    uintptr_t base = (uintptr_t)mh;
+    const struct load_command *lc = (const struct load_command *)(mh64 + 1);
+    for (uint32_t i = 0; i < mh64->ncmds; i++) {
+        if (lc->cmdsize < sizeof(struct load_command)) break;
+        if (lc->cmd == LC_SEGMENT_64) {
+            const struct segment_command_64 *seg = (const struct segment_command_64 *)lc;
+            uintptr_t s = base + seg->vmaddr;
+            uintptr_t e = s + seg->vmsize;
+            if (addr >= s && addr < e) {
+                if (!needWrite) return YES;
+                return (seg->initprot & VM_PROT_WRITE) != 0;
+            }
+        }
+        lc = (const struct load_command *)((uint8_t *)lc + lc->cmdsize);
+    }
+    return NO;
+}
