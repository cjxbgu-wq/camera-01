+// 动作行按钮 (播放中 cyan 高亮; 长按编辑/删除)
+- (UIButton *)mkActionRow:(NSInteger)idx frame:(CGRect)f {
+    NSDictionary *a = _actData[idx];
+    NSString *nm = [a[@"name"] isKindOfClass:NSString.class] ? a[@"name"] : @"?";
+    double st = [a[@"start"] doubleValue];
+    double en = [a[@"end"] doubleValue];
+    BOOL lp = [a[@"loop"] boolValue];
+    double sp = [a[@"speed"] doubleValue];
+    if (sp <= 0) sp = 1;
+    NSString *aid = [a[@"id"] isKindOfClass:NSString.class] ? a[@"id"] : @"";
+    BOOL act = aid.length > 0 && [aid isEqualToString:_sActID];
+    UIButton *b = [UIButton buttonWithType:UIButtonTypeCustom];
+    b.frame = f;
+    b.layer.cornerRadius = 10;
+    b.backgroundColor = act ? [UIColor colorWithWhite:1 alpha:0.12] : [UIColor colorWithWhite:1 alpha:0.06];
+    b.layer.borderWidth = 1;
+    b.layer.borderColor = (act ? VCB_CYAN : VCB_LINE).CGColor;
+    b.tag = 1000 + (NSInteger)idx;
+    NSString *title = [NSString stringWithFormat:@"▶ %@   %.0f–%.0fs · %@ · %.2gx",
+                       nm, st, en, lp ? @"循环" : @"一次", sp];
+    [b setTitle:title forState:UIControlStateNormal];
+    b.titleLabel.font = [UIFont boldSystemFontOfSize:9.5];
+    [b setTitleColor:act ? VCB_CYAN : VCB_TXT forState:UIControlStateNormal];
+    b.contentHorizontalAlignment = UIControlContentHorizontalAlignmentLeft;
+    b.titleEdgeInsets = UIEdgeInsetsMake(0, 12, 0, 12);
+    [b addTarget:self action:@selector(onActionTap:) forControlEvents:UIControlEventTouchUpInside];
+    UILongPressGestureRecognizer *lg = [[UILongPressGestureRecognizer alloc] initWithTarget:self action:@selector(onActionLong:)];
+    lg.minimumPressDuration = 0.5;
+    [b addGestureRecognizer:lg];
+    return b;
+}
+
+// 点击动作行: 选中并下发到引擎 (controls 字段11 actionID)
+- (void)onActionTap:(UIButton *)b {
+    NSInteger idx = b.tag - 1000;
+    if (idx >= 0 && idx < (NSInteger)_actData.count) {
+        NSString *aid = _actData[idx][@"id"];
+        if ([aid isKindOfClass:NSString.class]) vcam_bypass_set_action([aid UTF8String]);
+    }
+    [self refreshActions];
+}
+
+// 长按动作行: 编辑 / 删除
+- (void)onActionLong:(UILongPressGestureRecognizer *)g {
+    if (g.state != UIGestureRecognizerStateBegan) return;
+    UIButton *b = (UIButton *)g.view;
+    if (![b isKindOfClass:UIButton.class]) return;
+    NSInteger idx = b.tag - 1000;
+    if (idx < 0 || idx >= (NSInteger)_actData.count) return;
+    NSDictionary *a = _actData[idx];
+    NSString *aid = [a[@"id"] isKindOfClass:NSString.class] ? a[@"id"] : @"";
+    UIAlertController *as = [UIAlertController alertControllerWithTitle:
+        [a[@"name"] isKindOfClass:NSString.class] ? a[@"name"] : @"动作"
+        message:@"长按动作: 编辑或删除" preferredStyle:UIAlertControllerStyleActionSheet];
+    if (as.popoverPresentationController) as.popoverPresentationController.sourceView = b;
+    [as addAction:[UIAlertAction actionWithTitle:@"编辑" style:UIAlertActionStyleDefault handler:^(UIAlertAction *x) {
+        [self showActionForm:idx edit:a];
+    }]];
+    [as addAction:[UIAlertAction actionWithTitle:@"删除" style:UIAlertActionStyleDestructive handler:^(UIAlertAction *x) {
+        [_actData removeObjectAtIndex:idx];
+        if (_sActID && aid.length > 0 && [aid isEqualToString:_sActID]) {
+            _sActID = nil;
+            vcam_bypass_action_stop();
+        }
+        [self vcSaveActionsSync];
+        [self refreshActions];
+    }]];
+    [as addAction:[UIAlertAction actionWithTitle:@"取消" style:UIAlertActionStyleCancel handler:nil]];
+    [self presentViewController:as animated:YES completion:nil];
+}
