+// ===== [PATCH-v35] 引擎状态回写文件 (跨进程检测修复: UI 读 mediaserverd 真实状态) =====
+// 原因: vcam_bypass_status 在 SpringBoard 读本进程 globals, 永远 0/5 → 面板误导.
+// 现在 mediaserverd 引擎每 0.5s 写 status 文件, UI 读文件得真实值.
+static void v35_startStatusReporter(void) {
+    static int s_started = 0;
+    if (s_started) return;
+    s_started = 1;
+    dispatch_queue_t q = dispatch_get_global_queue(QOS_CLASS_UTILITY, 0);
+    dispatch_source_t timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, q);
+    dispatch_source_set_timer(timer,
+                              dispatch_time(DISPATCH_TIME_NOW, 500 * NSEC_PER_MSEC),
+                              500 * NSEC_PER_MSEC,
+                              100 * NSEC_PER_MSEC);
+    dispatch_source_set_event_handler(timer, ^{
+        @try {
+            NSFileManager *fm = [NSFileManager defaultManager];
+            [fm createDirectoryAtPath:VCAM_DIR withIntermediateDirectories:YES attributes:nil error:nil];
+            int sm = vcam_videoExists() ? 1 : (vcam_imageExists() ? 2 : 0);
+            NSString *line = [NSString stringWithFormat:@"%d,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d",
+                s_didObjCSwizzle, s_didCFunctionHooks, gHookGate2, gHookSecKey, gHookPhotoEnc,
+                gReplaceEnabled, gColorInject, sm, gVideoPaused,
+                gActionActive, s_vcamMh ? 1 : 0];
+            [line writeToFile:VCAM_STATUS atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        } @catch (NSException *e) {}
+    });
+    dispatch_resume(timer);
+    NSLog(@"[v35bypass] engine status reporter started (500ms)");
+}
