+// [PATCH-v34] 按 id 查动作配置
+static NSDictionary *vcam_actionByID(const char *aid) {
+    if (!aid || !aid[0] || !gActionsCfg) return nil;
+    for (NSDictionary *d in gActionsCfg) {
+        if (![d isKindOfClass:NSDictionary.class]) continue;
+        NSString *ident = d[@"id"];
+        if ([ident isKindOfClass:NSString.class] && [ident isEqualToString:[NSString stringWithUTF8String:aid]]) return d;
+    }
+    return nil;
+}
