+// [PATCH-v37] 日志页刷新: engine.log 全文 + 本进程内存缓冲 + 引擎心跳
+- (void)refreshLogs {
+    NSString *engine = vcam_bypass_engine_log();
+    NSString *local = vcam_bypass_logs();
+    // [PATCH-v38] 引擎心跳: status 文件由 mediaserverd 每 0.5s 写, 过期 = 引擎未运行
+    BOOL engineAlive = NO;
+    NSDictionary *attr = [[NSFileManager defaultManager] attributesOfItemAtPath:[vcb_dir() stringByAppendingString:@"/status"] error:nil];
+    if (attr) {
+        NSTimeInterval age = CACurrentMediaTime() - [attr[NSFileModificationDate] timeIntervalSince1970];
+        engineAlive = age < 3.0;
+    }
+    NSMutableString *m = [NSMutableString new];
+    [m appendString:engineAlive
+        ? @"▶ 引擎状态: [mediaserverd] 运行中 ✓\n"
+        : @"▶ 引擎状态: [mediaserverd] 未运行 ✗ (tweak 未注入引擎进程 → 所有功能不可用)\n"];
+    [m appendString:@"━━━ 完整运行日志 (engine.log) ━━━\n"];
+    [m appendString:engine ?: @"(无)"];
+    if (local.length) {
+        [m appendString:@"\n━━━ 面板内存日志 ━━━\n"];
+        [m appendString:local];
+    }
+    _logView.text = m;
+    [_logView scrollRangeToVisible:NSMakeRange(MAX(0, (NSInteger)m.length - 1), 0)];
+}
