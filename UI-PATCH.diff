+// [PATCH-v34] 按当前 gActionID 解析并激活区间模式; 无效 ID → 回退普通模式
+static void vcam_applyActionSelection(void) {
+    vcam_resetActionEngine();
+    if (!gActionID[0]) return;
+    NSDictionary *a = vcam_actionByID(gActionID);
+    if (!a) { gActionID[0] = 0; return; }
+    gActionStart = [a[@"start"] isKindOfClass:NSNumber.class] ? [a[@"start"] doubleValue] : 0;
+    gActionEnd   = [a[@"end"]   isKindOfClass:NSNumber.class] ? [a[@"end"]   doubleValue] : 0;
+    if (gActionEnd <= gActionStart) { gActionID[0] = 0; return; }
+    gActionLoop = [a[@"loop"] boolValue] ? 1 : 0;
+    gActionSpeed = [a[@"speed"] isKindOfClass:NSNumber.class] ? [a[@"speed"] floatValue] : 1.0f;
+    if (gActionSpeed < 0.1f) gActionSpeed = 1.0f;
+    if (gActionSpeed > 4.0f) gActionSpeed = 4.0f;
+    gActionFrameDur = 1.0 / 30.0;
+    gActionNextPos = gActionStart;
+    gActionActive = 1;
+    vcam_log2("action: %s [%.2f-%.2f] loop=%d speed=%.2f", gActionID, gActionStart, gActionEnd, gActionLoop, gActionSpeed);
+}
