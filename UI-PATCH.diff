+// 读下一帧 (v34 动作模式: 区间/循环/变速; 普通模式: EOF 自动重开 = 循环播放)
+// 调用方负责 CVPixelBufferRelease; 返回的 buffer 可能同时被引擎持有 (内部 retained)
+static CVPixelBufferRef vcam_readVideoFrame(void) {
+    if (!gLockA) return NULL;
+    [gLockA lock];
+    @try {
+        if (gActionActive) {
+            // ---- v34 动作区间模式 ----
+            if (!gReaderA || gReaderA.status != AVAssetReaderStatusReading) {
+                if (!vcam_openReaderForRange(&gReaderA, &gOutputA, gActionStart, gActionEnd)) {
+                    vcam_log2_rare("range-open", "action range reader open FAILED [%.2f-%.2f]", gActionStart, gActionEnd);
+                    [gLockA unlock]; return NULL;
+                }
+                gActionNextPos = gActionStart;
+                gRepeatAcc = 0;
+            }
+            for (;;) {
+                if (gRepeatAcc >= 1.0 && gActionHold) {  // 慢放 (speed<1): 复用上一帧
+                    gRepeatAcc -= 1.0;
+                    CVPixelBufferRef h = gActionHold;
+                    CVPixelBufferRetain(h);
+                    [gLockA unlock]; return h;
+                }
+                CMSampleBufferRef sb = [gOutputA copyNextSampleBuffer];
+                if (!sb) {
+                    if (gActionLoop) {  // 区间循环: 重开读取器
+                        if (!vcam_openReaderForRange(&gReaderA, &gOutputA, gActionStart, gActionEnd)) {
+                            [gLockA unlock]; return NULL;
+                        }
+                        gActionNextPos = gActionStart;
+                        gRepeatAcc = 0;
+                        continue;
+                    }
+                    [gLockA unlock];  // 无循环: 定格在区间尾帧
+                    if (gActionHold) { CVPixelBufferRef h = gActionHold; CVPixelBufferRetain(h); return h; }
+                    return NULL;
+                }
+                double pts = CMTimeGetSeconds(CMSampleBufferGetPresentationTimeStamp(sb));
+                double sdur = CMTimeGetSeconds(CMSampleBufferGetDuration(sb));
+                CVImageBufferRef pb = CMSampleBufferGetImageBuffer(sb);
+                CFRelease(sb);
+                if (pts > gActionEnd + 0.002) {
+                    if (gActionLoop) {
+                        if (!vcam_openReaderForRange(&gReaderA, &gOutputA, gActionStart, gActionEnd)) {
+                            [gLockA unlock]; return NULL;
+                        }
+                        gActionNextPos = gActionStart;
+                        gRepeatAcc = 0;
+                        continue;
+                    }
+                    [gLockA unlock];
+                    if (gActionHold) { CVPixelBufferRef h = gActionHold; CVPixelBufferRetain(h); return h; }
+                    return NULL;
+                }
+                if (pts < gActionStart - 0.002) continue;  // 读取器容差外帧丢弃
+                if (gActionSpeed >= 1.0f && pts < gActionNextPos - 0.001) continue;  // 快放: 跳帧
+                if (gActionHold) CVPixelBufferRelease(gActionHold);  // 帧复用区换新
+                gActionHold = (CVPixelBufferRef)pb;
+                CVPixelBufferRetain(gActionHold);
+                if (sdur > 0) gActionFrameDur = sdur;
+                if (gActionSpeed >= 1.0f) {
+                    gActionNextPos = pts + gActionFrameDur / gActionSpeed;
+                    if (gActionNextPos > gActionEnd) gActionNextPos = gActionEnd;
+                } else {
+                    gRepeatAcc += (1.0 / gActionSpeed - 1.0);
+                }
+                [gLockA unlock];
+                return (CVPixelBufferRef)pb;
+            }
+        }
+        if (!gReaderA || gReaderA.status != AVAssetReaderStatusReading) {
+            if (!vcam_openReader(&gReaderA, &gOutputA)) {
+                vcam_log2_rare("reader-open", "video reader open FAILED — video.mp4 decode error");
+                [gLockA unlock]; return NULL;
+            }
+        }
+        CMSampleBufferRef sb = [gOutputA copyNextSampleBuffer];
+        if (!sb) {
+            if (vcam_openReader(&gReaderA, &gOutputA)) sb = [gOutputA copyNextSampleBuffer];
+            if (!sb) { [gLockA unlock]; return NULL; }
+        }
+        CVImageBufferRef pb = CMSampleBufferGetImageBuffer(sb);
+        if (!pb) { CFRelease(sb); [gLockA unlock]; return NULL; }
+        CVPixelBufferRetain(pb);
+        CFRelease(sb);
+        [gLockA unlock];
+        return (CVPixelBufferRef)pb;
+    } @catch (NSException *e) { [gLockA unlock]; return NULL; }
+}
+
+// 暂停: 固定当前帧
+static CIImage *vcam_getPausedFrame(void) {
+    if (!gVideoPaused) return nil;
+    if (gPausedFrame) return gPausedFrame;
+    CVPixelBufferRef pb = vcam_readVideoFrame();
+    if (!pb) return nil;
+    CIImage *img = [CIImage imageWithCVImageBuffer:pb];
+    CVPixelBufferRelease(pb);
+    if (img) gPausedFrame = img;
+    return img;
+}
+
+// 旋转/翻转 (主源码 vcam_applyVideoTransforms)
+static CIImage *vcam_applyVideoTransforms(CIImage *img) {
+    if (!img) return nil;
+    if (gVideoRotation == 90) {
+        img = [img imageByApplyingOrientation:kCGImagePropertyOrientationRight];
+    } else if (gVideoRotation == 180) {
+        img = [img imageByApplyingOrientation:kCGImagePropertyOrientationDown];
+    } else if (gVideoRotation == 270) {
+        img = [img imageByApplyingOrientation:kCGImagePropertyOrientationLeft];
+    }
+    if (gVideoFlipH) {
+        CGRect ext = img.extent;
+        img = [img imageByApplyingTransform:CGAffineTransformMake(-1, 0, 0, 1, 2 * ext.origin.x + ext.size.width, 0)];
+    }
+    return img;
+}
+
+// 等比适配 + 黑边 (主源码 vcam_aspectFit)
+static CIImage *vcam_aspectFit(CIImage *img, size_t targetW, size_t targetH) {
+    CGRect ext = img.extent;
+    CGFloat srcW = ext.size.width, srcH = ext.size.height;
+    if (srcW <= 0 || srcH <= 0 || targetW == 0 || targetH == 0) return img;
+    if ((size_t)srcW == targetW && (size_t)srcH == targetH) return img;
+    CGFloat sx = (CGFloat)targetW / srcW;
+    CGFloat sy = (CGFloat)targetH / srcH;
+    CGFloat scale = MIN(sx, sy);
+    CGFloat scaledW = srcW * scale;
+    CGFloat scaledH = srcH * scale;
+    img = [img imageByApplyingTransform:CGAffineTransformMakeScale(scale, scale)];
+    CGFloat tx = ((CGFloat)targetW - scaledW) / 2.0 - ext.origin.x * scale;
+    CGFloat ty = ((CGFloat)targetH - scaledH) / 2.0 - ext.origin.y * scale;
+    img = [img imageByApplyingTransform:CGAffineTransformMakeTranslation(tx, ty)];
+    CIImage *bg = [[CIImage imageWithColor:[CIColor colorWithRed:0 green:0 blue:0 alpha:1]]
+                   imageByCroppingToRect:CGRectMake(0, 0, (CGFloat)targetW, (CGFloat)targetH)];
+    return [img imageByCompositingOverImage:bg];
+}
+
+// 颜色注入: 全屏 RGB+alpha 叠加 (主源码 vcam_applyColorInject 简化版, 无 Vision 人脸检测)
+static CIImage *vcam_applyColorInject(CIImage *img) {
+    if (!gColorInject || !img) return img;
+    if (gInjectR < 0.01 && gInjectG < 0.01 && gInjectB < 0.01) return img;
+    @try {
+        CGRect ext = img.extent;
+        CIColor *overlay = [CIColor colorWithRed:gInjectR green:gInjectG blue:gInjectB alpha:gInjectAlpha];
+        CIImage *colorImg = [[CIImage imageWithColor:overlay] imageByCroppingToRect:ext];
+        CIFilter *blend = [CIFilter filterWithName:@"CISourceOverCompositing"];
+        [blend setValue:colorImg forKey:kCIInputImageKey];
+        [blend setValue:img forKey:kCIInputBackgroundImageKey];
+        CIImage *result = blend.outputImage;
+        return result ?: img;
+    } @catch (NSException *e) { return img; }
+}
+
+// 渲染视频/图片源 → 目标尺寸 BGRA buffer (黑边已合成). 调用方负责 release.
+static CVPixelBufferRef vcam_renderSourceToBGRA(size_t targetW, size_t targetH) {
+    @try {
+        CIImage *src = nil;
+        if (vcam_imageExists()) {
+            NSData *data = [NSData dataWithContentsOfFile:VCAM_IMAGE];
+            if (data && data.length > 0) src = [CIImage imageWithData:data];
+        }
+        if (!src && vcam_videoExists()) {
+            CIImage *paused = vcam_getPausedFrame();
+            if (paused) {
+                src = paused;
+            } else {
+                CVPixelBufferRef pb = vcam_readVideoFrame();
+                if (pb) {
+                    src = [CIImage imageWithCVImageBuffer:pb];
+                    CVPixelBufferRelease(pb);
+                }
+            }
+        }
+        if (!src) return NULL;
+        src = vcam_applyVideoTransforms(src);
+        src = vcam_aspectFit(src, targetW, targetH);
+        src = vcam_applyColorInject(src);
+        CGRect ext = src.extent;
+        if (ext.origin.x != 0 || ext.origin.y != 0) {
+            src = [src imageByApplyingTransform:CGAffineTransformMakeTranslation(-ext.origin.x, -ext.origin.y)];
+        }
+        if (!gCICtx) {
+            gCICtx = [CIContext contextWithOptions:@{kCIContextUseSoftwareRenderer: @NO}];
+        }
+        NSDictionary *pba = @{
+            (NSString *)kCVPixelBufferIOSurfacePropertiesKey: @{},
+            (NSString *)kCVPixelBufferCGImageCompatibilityKey: @YES,
+            (NSString *)kCVPixelBufferCGBitmapContextCompatibilityKey: @YES,
+        };
+        CVPixelBufferRef outPB = NULL;
+        CVReturn r = CVPixelBufferCreate(kCFAllocatorDefault, targetW, targetH,
+                                         kCVPixelFormatType_32BGRA,
+                                         (__bridge CFDictionaryRef)pba, &outPB);
+        if (r != kCVReturnSuccess || !outPB) return NULL;
+        [gCICtx render:src toCVPixelBuffer:outPB];
+        CVPixelBufferLockBaseAddress(outPB, kCVPixelBufferLock_ReadOnly);
+        CVPixelBufferUnlockBaseAddress(outPB, kCVPixelBufferLock_ReadOnly);
+        return outPB;
+    } @catch (NSException *e) { return NULL; }
+}
+
+// ===== [PATCH-v33] 跨进程 controls 文件 =====
+static void vcam_applyControls(NSString *content) {
+    if (!content || content.length < 3) return;
+    NSArray *parts = [content componentsSeparatedByString:@","];
+    // 0=on,1=rot,2=flip,3=pause,4=colorInject,5=R,6=G,7=B,8=alpha,9=replace,10=patternColor
+    // 11=actionID,12=stop (v34: VCActionSystem 分段动作)
+    if (parts.count < 9) return;
+    int newRot = [parts[1] intValue];
+    int newFlip = [parts[2] intValue];
+    BOOL newPause = [parts[3] intValue] != 0;
+    if (newPause != gVideoPaused) {
+        gPausedFrame = nil;
+    }
+    gVideoRotation = newRot;
+    gVideoFlipH = newFlip;
+    gVideoPaused = newPause;
+    gColorInject = [parts[4] intValue];
+    gInjectR = [parts[5] doubleValue];
+    gInjectG = [parts[6] doubleValue];
+    gInjectB = [parts[7] doubleValue];
+    gInjectAlpha = [parts[8] doubleValue];
+    if (parts.count >= 10) gReplaceEnabled = [parts[9] intValue];
+    if (parts.count >= 11) {
+        uint32_t pc = (uint32_t)strtoul([parts[10] UTF8String], NULL, 0);
+        if (pc != gPatternColor) {
+            gPatternColor = pc;
+            if (s_testPattern) { CVPixelBufferRelease(s_testPattern); s_testPattern = NULL; }
+        }
+    }
+    // [PATCH-v34] 动作选择/停止
+    if (parts.count >= 12) {
+        NSString *newAct = parts[11];
+        BOOL sameID = (gActionID[0] != 0) && [newAct isEqualToString:[NSString stringWithUTF8String:gActionID]];
+        if (!sameID) {
+            strncpy(gActionID, [newAct UTF8String] ? [newAct UTF8String] : "", sizeof(gActionID) - 1);
+            gActionID[sizeof(gActionID) - 1] = 0;
+            vcam_applyActionSelection();
+        }
+    }
+    if (parts.count >= 13 && [parts[12] intValue] != 0) {
+        if (gActionID[0] || gActionActive) { gActionID[0] = 0; vcam_resetActionEngine(); }
+    }
+}
+
+static void vcam_readControls(void) {
+    static NSTimeInterval sLastRead = 0;
+    NSTimeInterval now = CACurrentMediaTime();
+    if (now - sLastRead < 0.3) return;
+    sLastRead = now;
+    @try {
+        vcam_reloadActionsIfNeeded();
+        NSString *content = [NSString stringWithContentsOfFile:VCAM_FLAG encoding:NSUTF8StringEncoding error:nil];
+        if (content) vcam_applyControls(content);
+    } @catch (NSException *e) {}
+}
+
+// UI(SpringBoard) 侧写 controls 文件 (v34: 13 字段)
+static void vcam_writeControls(void) {
+    @try {
+        NSString *line = [NSString stringWithFormat:@"1,%d,%d,%d,%d,%.4f,%.4f,%.4f,%.4f,%d,%u,%s,%d",
+            gVideoRotation, gVideoFlipH, gVideoPaused, gColorInject,
+            gInjectR, gInjectG, gInjectB, gInjectAlpha,
+            gReplaceEnabled, (unsigned)gPatternColor,
+            gActionID, gActionStop];
+        [line writeToFile:VCAM_FLAG atomically:YES encoding:NSUTF8StringEncoding error:nil];
+        vcam_log2("controls: %s", [line UTF8String]);
+    } @catch (NSException *e) {}
+}
