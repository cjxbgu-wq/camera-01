+// [PATCH-v41] 系统相机管线探测器 — 不依赖 vcameracrack 内部 (千面版无
+// LicenseCore/VCamCore, 0x63xxx 偏移全部段外): 直接枚举系统类方法列表,
+// 拿到真实 selector 供重写替换核心使用. 任意进程跑, 结果进 engine.log.
+static void v41_probeOnce(int pass) {
+    @autoreleasepool {
+        const char *names[] = {"BWNodeOutput", "BWStillImageScalerNode",
+                               "BWPhotoEncoderNode", "GPUImageProcessor",
+                               "LicenseCore", "VCamCore", "LocalVideoPlayer",
+                               "AVCaptureSession", "AVCaptureVideoDataOutput"};
+        BOOL fullMethods[] = {YES, YES, YES, YES,
+                              YES, YES, YES,
+                              NO, NO};  // 标准类只查存在性, 省日志
+        NSMutableString *line = [NSMutableString stringWithFormat:@"v41 probe pass%d:", pass];
+        for (int i = 0; i < (int)(sizeof(names)/sizeof(names[0])); i++) {
+            Class c = objc_getClass(names[i]);
+            [line appendFormat:@" %s=%d", names[i], c != NULL];
+            if (!c || !fullMethods[i]) continue;
+            unsigned int mc = 0;
+            Method *ml = class_copyMethodList(c, &mc);
+            if (!ml) continue;
+            NSMutableString *ms = [NSMutableString string];
+            for (unsigned int j = 0; j < mc; j++) {
+                [ms appendFormat:@"%s|", sel_getName(method_getName(ml[j]))];
+            }
+            free(ml);
+            // vcam_log2 缓冲 192B → 分块 ~120 字符/行, 保证全量方法不截断
+            NSMutableString *block = [NSMutableString string];
+            for (NSUInteger ci = 0; ci < ms.length; ci++) {
+                [block appendFormat:@"%C", [ms characterAtIndex:ci]];
+                if (block.length >= 120 || ci == ms.length - 1) {
+                    vcam_log2("v41 %s methods(%u): %s", names[i], mc, block.UTF8String);
+                    [block setString:@""];
+                }
+            }
+        }
+        vcam_log2("%s", line.UTF8String);
+    }
+}
+
+static void v41_startProbe(void) {
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC),
+                   dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{
+        v41_probeOnce(1);
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 15 * NSEC_PER_SEC),
+                       dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{
+            v41_probeOnce(2);
+        });
+    });
+}
