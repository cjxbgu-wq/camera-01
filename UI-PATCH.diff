+// [PATCH-v36] 引擎是否匹配到 vcam dylib (跨进程: 读 status 文件第 11 字段)
+int vcam_bypass_engine_detected(void) {
+    @try {
+        NSDictionary *attr = [[NSFileManager defaultManager] attributesOfItemAtPath:VCAM_STATUS error:nil];
+        if (attr) {
+            NSTimeInterval age = CACurrentMediaTime() - [attr[NSFileModificationDate] timeIntervalSince1970];
+            if (age < 2.0) {
+                NSString *content = [NSString stringWithContentsOfFile:VCAM_STATUS encoding:NSUTF8StringEncoding error:nil];
+                NSArray *p = [content componentsSeparatedByString:@","];
+                if (p.count >= 11) return [p[10] intValue];
+            }
+        }
+    } @catch (NSException *e) {}
+    return s_vcamMh ? 1 : 0;
+}
