+BOOL vcam_bypass_status(int *swizzled, int *cfhooks, int *gate2, int *seckey, int *photoenc) {
+    // [PATCH-v35] 优先读 mediaserverd 引擎回写的 status 文件 (真实状态)
+    @try {
+        NSDictionary *attr = [[NSFileManager defaultManager] attributesOfItemAtPath:VCAM_STATUS error:nil];
+        if (attr) {
+            NSTimeInterval age = CACurrentMediaTime() - [attr[NSFileModificationDate] timeIntervalSince1970];
+            if (age < 2.0) {  // 文件新鲜 → 引擎活着, 用引擎值
+                NSString *content = [NSString stringWithContentsOfFile:VCAM_STATUS encoding:NSUTF8StringEncoding error:nil];
+                NSArray *p = [content componentsSeparatedByString:@","];
+                if (p.count >= 5) {
+                    if (swizzled) *swizzled = [p[0] intValue];
+                    if (cfhooks)  *cfhooks  = [p[1] intValue];
+                    if (gate2)    *gate2    = [p[2] intValue];
+                    if (seckey)   *seckey   = [p[3] intValue];
+                    if (photoenc) *photoenc = [p[4] intValue];
+                    return ([p[0] intValue] && [p[1] intValue] && [p[2] intValue] && [p[3] intValue]) ? YES : NO;
+                }
+            }
+        }
+    } @catch (NSException *e) {}
+    // 回退: 本进程 globals (非引擎进程时基本全 0)
+    if (swizzled) *swizzled = s_didObjCSwizzle;
+    if (cfhooks)  *cfhooks  = s_didCFunctionHooks;
+    if (gate2)    *gate2    = gHookGate2;
+    if (seckey)   *seckey   = gHookSecKey;
+    if (photoenc) *photoenc = gHookPhotoEnc;
+    return (s_didObjCSwizzle && s_didCFunctionHooks && gHookGate2 && gHookSecKey) ? YES : NO;
+}
