+static void onImageLoad(const struct mach_header *mh, intptr_t slide) {
+    Dl_info info;
+    if (dladdr((const void *)mh, &info) == 0) return;
+    if (!info.dli_fname) return;
+    // [PATCH-v36] 诊断: 打印所有含 vcam 的加载 image; 匹配放宽到 "vcam" 子串
+    // (千面改名/大小写变化导致 strstr("vcameracrack") 静默失效 = 全功能不生效根因之一)
+    if (strstr(info.dli_fname, "vcam")) {
+        vcam_log2("vcam image load: %s", info.dli_fname);
+    }
+    if (!strstr(info.dli_fname, "vcameracrack")) {
+        if (strstr(info.dli_fname, "vcam")) {
+            vcam_log2("image contains 'vcam' but not 'vcameracrack' — checking segments");
+            // 校验关键偏移, 全通过则视为目标 (防止改名后静默失效)
+            BOOL ok = vcam_addrInImage(mh, (uintptr_t)mh + 0x63ab4, YES)
+                   && vcam_addrInImage(mh, (uintptr_t)mh + 0xe9f4, NO)
+                   && vcam_addrInImage(mh, (uintptr_t)mh + 0xe240, NO);
+            if (ok) vcam_log2("segment offsets MATCH — treat as vcameracrack");
+            else { vcam_log2("offsets mismatch, skip"); return; }
+        } else {
+            return;
+        }
+    }
+
+    vcam_log2("*** vcameracrack loaded at %p slide=0x%lx path=%s",
+              mh, (unsigned long)slide, info.dli_fname);
+    s_vcamMh = mh;
+    s_vcamDylibName[0] = 0;
+    strncpy(s_vcamDylibName, info.dli_fname, sizeof(s_vcamDylibName) - 1);
+    // [PATCH-v39] 状态回写由真实引擎进程启动 (千面在 com.apple.lskdd 进程,
+    // 非 mediaserverd — 否则 status 文件永远假 0/5 或缺失)
+    v35_startStatusReporter();
+
+    // C-function hooks immediately
+    applyCHooks(mh);
+
+    // Write ivars NOW (before vcam125 +load tries to verify license)
+    writeVcamIvars(mh);
+
+    // Start periodic re-write timer to enforce against vcam125's own clearing
+    startIvarEnforcer();
+
+    // ObjC class hooks deferred via retry
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{
+        tryObjCSwizzle(100);
+    });
+}
