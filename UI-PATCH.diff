+// Apply C-function hooks (gate2 + SecKey) — these only need vcam125 dylib loaded
+static void applyCHooks(const struct mach_header *mh) {
+    if (s_didCFunctionHooks) return;
+    s_didCFunctionHooks = 1;
+
+    s_mh_for_render = mh;
+
+    // gate2 (vcam125 dylib base + 0xe9f4) — [PATCH-v36] 先段校验再挂
+    uintptr_t g2 = (uintptr_t)mh + 0xe9f4;
+    if (!vcam_addrInImage(mh, g2, NO)) {
+        vcam_log2("gate2 offset 0xe9f4 OUT OF IMAGE — vcam125 version mismatch, skip");
+    } else {
+        @try {
+            MSHookFunction((void *)g2, (void *)my_gate2, (void **)&orig_gate2);
+            gHookGate2 = 1;
+            vcam_log2("gate2 @ %p hooked", (void *)g2);
+        } @catch (NSException *e) {
+            vcam_log2("gate2 hook FAILED: %@", e);
+        }
+    }
+
+    // SecKeyVerifySignature framework hook
+    void *sec_ptr = dlsym(RTLD_DEFAULT, "SecKeyVerifySignature");
+    if (sec_ptr && !orig_SecKeyVerifySig) {
+        @try {
+            MSHookFunction(sec_ptr, (void *)my_SecKeyVerifySig, (void **)&orig_SecKeyVerifySig);
+            gHookSecKey = 1;
+            NSLog(@"[v27bypass] SecKeyVerifySignature hooked");
+        } @catch (NSException *e) {
+            NSLog(@"[v27bypass] SecKeyVerifySig hook FAILED: %@", e);
+        }
+    }
+
+    // v31: 只 MSHookFunction BWPhotoEncoder (v28 work 的方式)
+    // BWStillImageScaler 0xe234 不能 MSHookFunction — 与 0xe240 间距 12B, trampoline 16B 会重叠崩
+    // 改在 tryObjCSwizzle 延迟 retry 里 method_setImplementation 替换 (vcam125 +load 完成后)
+    uintptr_t pe = (uintptr_t)mh + 0xe240;   // [PATCH-v36] 先段校验再挂
+    if (!vcam_addrInImage(mh, pe, NO)) {
+        vcam_log2("photoenc offset 0xe240 OUT OF IMAGE — skip");
+    } else {
+        @try {
+            MSHookFunction((void *)pe, (void *)my_photoenc_passthrough, (void **)&orig_photoenc_newImp);
+            gHookPhotoEnc = 1;
+            vcam_log2("BWPhotoEncoder.render newImp passthrough hooked");
+        } @catch (NSException *e) { vcam_log2("photoenc hook fail: %@", e); }
+    }
+}
