+__attribute__((constructor))
+static void v16_init(void) {
+    NSString *proc = [[NSProcessInfo processInfo] processName];
+    vcam_log2("ctor in process: %s", [proc UTF8String] ? [proc UTF8String] : "?");
+    // [PATCH-v36] 枚举已加载 image, 打印含 vcam 的 (诊断 vcameracrack 加载情况)
+    for (uint32_t i = 0; i < _dyld_image_count(); i++) {
+        const char *nm = _dyld_get_image_name(i);
+        if (nm && strstr(nm, "vcam")) vcam_log2("loaded image: %s", nm);
+    }
+    _dyld_register_func_for_add_image(onImageLoad);
+    vcam_log2("dyld add_image callback registered");
+
+    // ALSO start an independent retry loop in case dyld callback never sees vcameracrack
+    // (already-loaded edge case — though dyld should fire for already-loaded images)
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 200 * NSEC_PER_MSEC),
+                   dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0),
+                   ^{ tryObjCSwizzle(100); });
+    // [PATCH-v41] 系统相机管线探测 (mediaserverd/SpringBoard/任意进程): 5s/15s/30s 三次
+    v41_startProbe();
+    vcap_ui_mount(); // [PATCH-v32] UI 模块挂载 (仅 SpringBoard 生效)
+    // [PATCH-v35/v39/v40] 状态回写由「匹配到 vcameracrack 的进程」启动 (见 onImageLoad),
+    // v40: plist Filter 已移除 → 全进程注入, 引擎在任意含 vcameracrack 的进程自适应激活
+    // (千面实测只加载于其自身 filter 的 App 进程; 我们不再猜目标进程)
+    // [PATCH-v33] 视频读取器锁初始化
+    if (!gLockA) gLockA = [NSLock new];
+    vcam_readControls(); // 启动即同步一次 controls
+}
