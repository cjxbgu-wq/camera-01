+// [PATCH-v41] RootHide 官方 API: jbroot() 替代硬编码 /var/jb. 运行期 dlsym 解析
+// (weak_import 对非系统符号无效 → dlsym, 非 RootHide 环境无 jbroot 符号 → 回退 /var/jb)
+#import <dlfcn.h>
+static const char *(*jbroot_fn)(const char *) = NULL;
+static NSString *vcb_jbPath(NSString *sub) {
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        jbroot_fn = (const char *(*)(const char *))dlsym(RTLD_DEFAULT, "jbroot");
+    });
+    if (jbroot_fn) {
+        const char *p = jbroot_fn(sub.UTF8String);
+        if (p) return [NSString stringWithUTF8String:p];
+    }
+    return [@"/var/jb" stringByAppendingPathComponent:sub];
+}
+static NSString *vcb_dir(void) {
+    static NSString *dir = nil;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{ dir = vcb_jbPath(@"var/mobile/Library/vcamplus"); });
+    return dir;
+}
