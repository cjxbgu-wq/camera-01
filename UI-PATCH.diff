+// [PATCH-v34] actions.json 变更检测重载 (mtime 比对, 与 UI 进程 0.3s 节流写盘配合)
+static void vcam_reloadActionsIfNeeded(void) {
+    @try {
+        NSFileManager *fm = [NSFileManager defaultManager];
+        NSDictionary *attr = [fm attributesOfItemAtPath:VCAM_ACTIONS error:nil];
+        uint64_t mt = attr ? (uint64_t)([attr[NSFileModificationDate] timeIntervalSince1970] * 1000.0) : 0;
+        if (mt == gActionCfgMtime) return;
+        gActionCfgMtime = mt;
+        NSData *data = [NSData dataWithContentsOfFile:VCAM_ACTIONS];
+        id obj = data ? [NSJSONSerialization JSONObjectWithData:data options:0 error:nil] : nil;
+        NSArray *acts = [obj isKindOfClass:NSDictionary.class] ? ((NSDictionary *)obj)[@"actions"] : nil;
+        gActionsCfg = [acts isKindOfClass:NSArray.class] ? acts : @[];
+        if (gActionID[0]) vcam_applyActionSelection();
+    } @catch (NSException *e) {}
+}
