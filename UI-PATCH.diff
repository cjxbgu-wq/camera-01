+// 动作列表重建 (最多 5 行)
+- (void)rebuildActionList {
+    for (UIView *v in _actListHost.subviews) [v removeFromSuperview];
+    if (_actData.count == 0) {
+        UILabel *e = [[UILabel alloc] initWithFrame:CGRectMake(20, 16, _actListHost.bounds.size.width - 40, 14)];
+        e.text = @"暂无动作 · 点「＋ 添加动作」创建";
+        e.font = [UIFont systemFontOfSize:9];
+        e.textColor = VCB_GRAY;
+        e.textAlignment = NSTextAlignmentCenter;
+        [_actListHost addSubview:e];
+        return;
+    }
+    NSInteger n = MIN((NSInteger)_actData.count, 5);
+    for (NSInteger i = 0; i < n; i++) {
+        UIButton *b = [self mkActionRow:i frame:CGRectMake(20, 2 + i * 42, _actListHost.bounds.size.width - 40, 36)];
+        [_actListHost addSubview:b];
+    }
+}
