+static int gReplaceEnabled    = 1;                       // 画面替换总开关
+static int gCameraPassEnabled = 1;                       // 相机真画面 (photoFlag=1 跳过)
+static uint32_t gPatternColor = 0xFFFF0000U;             // 测试图案颜色 BGRA
+static int gHookGate2 = 0, gHookSecKey = 0, gHookPhotoEnc = 0; // 逐项 hook 成功标志
+static char gLogBuf[64][192];
+static volatile int gLogHead = 0, gLogCount = 0;
+// [PATCH-v37] 统一日志落盘: 所有进程 (mediaserverd 引擎 + SpringBoard UI) 的关键事件
+// 追加写 engine.log (限 300 行), 面板「日志」页读取 → 软件内可见完整运行日记.
+// v38: flock 加锁防止 SpringBoard/mediaserverd 并发写互相覆盖丢行.
+static void vcam_persistLog(const char *line) {
+    @try {
+        NSString *dir = vcam_dir();
+        [[NSFileManager defaultManager] createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:nil];
+        const char *path = [[dir stringByAppendingPathComponent:@"engine.log"] UTF8String];
+        int fd = open(path, O_CREAT | O_RDWR, 0644);
+        if (fd < 0) return;
+        flock(fd, LOCK_EX);
+        NSMutableString *all = [NSMutableString new];
+        char buf[4096];
+        ssize_t n;
+        while ((n = read(fd, buf, sizeof(buf))) > 0) {
+            [all appendString:[[NSString alloc] initWithBytes:buf length:(NSUInteger)n encoding:NSUTF8StringEncoding]];
+        }
+        NSString *proc = [[NSProcessInfo processInfo] processName];
+        [all appendFormat:@"[%@] %s\n", proc, line];
+        NSArray *ls = [all componentsSeparatedByString:@"\n"];
+        if (ls.count > 300) ls = [ls subarrayWithRange:NSMakeRange(ls.count - 300, 300)];
+        NSString *out = [ls componentsJoinedByString:@"\n"];
+        const char *cstr = [out UTF8String];
+        ftruncate(fd, 0);
+        lseek(fd, 0, SEEK_SET);
+        ssize_t w = write(fd, cstr, strlen(cstr));
+        flock(fd, LOCK_UN);
+        close(fd);
+        (void)w;
+    } @catch (NSException *e) {}
+}
+static void vcam_log2(const char *fmt, ...) {
+    char tmp[192]; va_list ap;
+    va_start(ap, fmt); vsnprintf(tmp, sizeof(tmp), fmt, ap); va_end(ap);
+    NSLog(@"[vcampro] %s", tmp);
+    snprintf(gLogBuf[gLogHead % 64], sizeof(gLogBuf[0]), "[v32] %s", tmp);
+    gLogHead++;
+    if (gLogCount < 64) gLogCount++;
+    vcam_persistLog(tmp);
+}
+// [PATCH-v37] 限频日志 (帧级错误用, 每 key 5s 最多一条, 防刷爆日志文件)
+#define VCAM_RATE_SLOTS 8
+static char s_rateKeys[VCAM_RATE_SLOTS][32];
+static NSTimeInterval s_rateLast[VCAM_RATE_SLOTS];
+static void vcam_log2_rare(const char *key, const char *fmt, ...) {
+    NSTimeInterval now = CACurrentMediaTime();
+    for (int i = 0; i < VCAM_RATE_SLOTS; i++) {
+        if (!s_rateKeys[i][0]) {
+            strncpy(s_rateKeys[i], key, 31); s_rateKeys[i][31] = 0;
+            s_rateLast[i] = now;
+            break;
+        }
+        if (strcmp(s_rateKeys[i], key) == 0) {
+            if (now - s_rateLast[i] < 5.0) return;
+            s_rateLast[i] = now;
+            break;
+        }
+    }
+    char tmp[192]; va_list ap;
+    va_start(ap, fmt); vsnprintf(tmp, sizeof(tmp), fmt, ap); va_end(ap);
+    vcam_log2("%s", tmp);
+}
