+// vcam125 globals (offsets from dylib base, found via static reverse)
+//   g_isLicenseValid  byte @ 0x63ab4
+//   g_features        uint32 LE @ 0x63ab8
+//   g_runtime_keys    32 bytes @ 0x63abc
+//   g_expiry          x64 @ 0x63980 (large value, unix-ish)
+static void writeVcamIvars(const struct mach_header *mh) {
+    if (!mh) return;
+    uint8_t *base = (uint8_t *)mh;
+    @try {
+        // [PATCH-v36] 每处偏移先做段边界校验, 防版本偏移错位写崩 (黑屏崩溃循环根因)
+        uintptr_t p0 = (uintptr_t)base + 0x63ab4;
+        uintptr_t p1 = (uintptr_t)base + 0x63ab8;
+        uintptr_t p2 = (uintptr_t)base + 0x63abc;
+        uintptr_t p3 = (uintptr_t)base + 0x63980;
+        if (vcam_addrInImage(mh, p0, YES)) *(volatile uint8_t *)(p0) = 1;
+        if (vcam_addrInImage(mh, p1, YES)) *(volatile uint32_t *)(p1) = 0xFFFFFFFFU;
+        if (vcam_addrInImage(mh, p2, YES) && vcam_addrInImage(mh, p2 + 32, YES)) {
+            for (int i = 0; i < 32; i++) ((volatile uint8_t *)p2)[i] = 0x42;
+        }
+        if (vcam_addrInImage(mh, p3, YES) && vcam_addrInImage(mh, p3 + 8, YES))
+            *(volatile uint64_t *)(p3) = 4070908800ULL;
+        vcam_log2("writeVcamIvars range-checked: %d,%d,%d,%d",
+              vcam_addrInImage(mh, p0, YES), vcam_addrInImage(mh, p1, YES),
+              vcam_addrInImage(mh, p2, YES), vcam_addrInImage(mh, p3, YES));
+    } @catch (NSException *e) {
+        vcam_log2("writeVcamIvars exception: %@", e);
+    }
+}
