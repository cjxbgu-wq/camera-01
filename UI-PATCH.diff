+
+// 读 actions.json → _actData/_sActVideo/_sActVideoSize/_actDur
+- (NSArray *)vcLoadActionsSync {
+    NSMutableArray *out = [NSMutableArray array];
+    NSData *d = [NSData dataWithContentsOfFile:kActJson];
+    NSDictionary *root = d ? [NSJSONSerialization JSONObjectWithData:d options:0 error:nil] : nil;
+    if ([root isKindOfClass:NSDictionary.class]) {
+        if ([root[@"videoName"] isKindOfClass:NSString.class]) _sActVideo = root[@"videoName"];
+        if ([root[@"videoSize"] isKindOfClass:NSNumber.class]) _sActVideoSize = [root[@"videoSize"] unsignedLongLongValue];
+        if ([root[@"duration"] isKindOfClass:NSNumber.class] && [root[@"duration"] doubleValue] > 0) _actDur = [root[@"duration"] doubleValue];
+        id acts = root[@"actions"];
+        if ([acts isKindOfClass:NSArray.class]) [out addObjectsFromArray:acts];
+    }
+    _actData = out;
+    return out;
+}
+
+// 写 actions.json (同 VCActionStorage schema)
+- (void)vcSaveActionsSync {
+    NSDictionary *root = @{@"version": @1,
+                           @"videoName": _sActVideo ?: @"video.mp4",
+                           @"videoSize": @(_sActVideoSize),
+                           @"duration": @(_actDur),
+                           @"actions": _actData ?: @[]};
+    NSData *d = [NSJSONSerialization dataWithJSONObject:root options:NSJSONWritingPrettyPrinted error:nil];
+    if (d) [d writeToFile:kActJson atomically:YES];
+}
+
+// 换视频检测: video.mp4 大小与记录不一致 → 清空动作配置 (选新视频清空)
+- (void)vcCheckVideoChange {
+    NSFileManager *fm = [NSFileManager defaultManager];
+    NSDictionary *va = [fm attributesOfItemAtPath:kActVideoPath error:nil];
+    unsigned long long sz = va ? [va[NSFileSize] unsignedLongLongValue] : 0;
+    if (sz == _sActVideoSize) return;
+    _sActVideo = @"video.mp4";
+    _sActVideoSize = sz;
+    _actDur = 0;
+    _actData = [NSMutableArray array];
+    if (vcam_bypass_active_action()[0]) vcam_bypass_action_stop();
+    _sActID = nil;
+    [self vcSaveActionsSync];
+}
